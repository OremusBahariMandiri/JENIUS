@push('scripts')
<script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
<script>
function toggleHeader() {
    const body    = document.getElementById('headerBody');
    const chevron = document.getElementById('headerChevron');
    const shown   = body.style.display !== 'none';
    body.style.display = shown ? 'none' : 'block';
    chevron.className  = shown ? 'fas fa-chevron-down' : 'fas fa-chevron-up';
}

$(document).ready(function(){
    // Select2
    $('.s2-coa').select2({
        theme: 'bootstrap-5',
        placeholder: '-- Akun --',
        allowClear: true,
        width: '100%',
    });

    // Currency formatting
    function parseCur(v) {
        return parseFloat(String(v).replace(/\./g,'').replace(',','.')) || 0;
    }
    function fmtCur(n) {
        return Math.round(n).toLocaleString('id-ID');
    }

    $(document).on('input', '.currency-input', function(){
        let raw = $(this).val().replace(/\./g,'').replace(/[^0-9]/g,'');
        let num = parseInt(raw) || 0;
        $(this).val(num > 0 ? num.toLocaleString('id-ID') : '');
        recalc();
    });

    $(document).on('change', '.item-reimb-cb', function(){
        recalc();
    });

    function recalc() {
        let dpp = 0, ppn = 0, reimb = 0;
        $('.item-row').each(function(){
            const isTax  = $(this).data('is-tax') == 1;
            const nom    = parseCur($(this).find('.currency-input').val());
            const isReimb = $(this).find('.item-reimb-cb').is(':checked');
            if(isTax)        ppn   += nom;
            else if(isReimb) reimb += nom;
            else             dpp   += nom;
        });
        $('#summDpp').text(fmtCur(dpp));
        $('#summPpn').text(fmtCur(ppn));
        $('#summReimb').text(fmtCur(reimb));
        $('#summTotal').text(fmtCur(dpp + ppn + reimb));
    }
});
</script>
@endpush
